# ── Core ──
NODE_ENV=development
PORT=3000
FRONTEND_URL=https://app.yourdomain.com

# ── Database ──
DATABASE_URL="postgresql://user:password@localhost:5432/flowdesk?schema=public"

# ── Redis ──
REDIS_URL="redis://localhost:6379"

# ── Auth ──
JWT_SECRET="generate-a-64-char-random-string-here-abcdefghijklmnopqrstuvwxyz"
JWT_REFRESH_SECRET="generate-another-64-char-random-string-here-different-from-jwt"

# 32-byte key as 64 hex chars — encrypts secrets at rest (WhatsApp tokens).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-64-hex-char-encryption-key

# ── Meta WhatsApp Cloud API ──
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_VERIFY_TOKEN=your-webhook-verify-token
META_WEBHOOK_SECRET=your-app-secret-for-signature-verification
META_API_VERSION=v20.0
META_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
META_ACCESS_TOKEN=your-long-lived-access-token
# Required for owner signup/login via Meta Embedded Signup. The public
# /api/v1/whatsapp/config endpoint exposes appId/configId to the browser.
META_CONFIG_ID=your-embedded-signup-config-id

# ── AI / Intent Classification ──
# Set to 'anthropic' (default) or 'nvidia' for local dev testing.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key
HAIKU_FALLBACK_ENABLED=true
HAIKU_CONFIDENCE_THRESHOLD=0.75

# NVIDIA NIM — only needed when AI_PROVIDER=nvidia
# Get a key at: https://build.nvidia.com/explore/discover
NVIDIA_API_KEY=your-nvidia-api-key
NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# ── AWS S3 (Media uploads) ──
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=eu-west-1
AWS_S3_BUCKET=your-flowdesk-bucket-name

# ── Email (optional, for notifications) ──
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ── Paystack (Billing) ──
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Monitoring (optional) ──
SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@xxxxxxxx.ingest.sentry.io/xxxxxxx
LOG_LEVEL=info
