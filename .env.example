# ── Core ──
NODE_ENV=development
PORT=3000
FRONTEND_URL=https://app.yourdomain.com

# ── Database ──
DIRECT_URL="postgresql://user:password@localhost:5432/flowdesk?schema=public"
# Runtime connection. On Supabase this is the pooled URL (port 6543,
# ?pgbouncer=true); DIRECT_URL above stays on 5432 for migrations.
DATABASE_URL="postgresql://user:password@localhost:5432/flowdesk?schema=public"

# ── Redis ──
REDIS_URL="redis://localhost:6379"

# ── Auth ──
JWT_SECRET="generate-a-64-char-random-string-here-abcdefghijklmnopqrstuvwxyz"
JWT_REFRESH_SECRET="generate-another-64-char-random-string-here-different-from-jwt"

# 32-byte key as 64 hex chars — encrypts secrets at rest (WhatsApp tokens).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-64-hex-char-encryption-key

# ── Meta WhatsApp Cloud API ──
#
# Flowdesk is a Meta Tech Provider. Every business connects its OWN WhatsApp
# Business number through Embedded Signup, and its phone number id, WABA id and
# permanent access token are stored encrypted on that business's row. So these
# are the PLATFORM's app-level credentials only — they are never one number's
# credentials, and one tenant can never send on another's number.
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
# The token Meta echoes back during the webhook subscription handshake.
META_VERIFY_TOKEN=your-webhook-verify-token
# Used to verify the X-Hub-Signature-256 HMAC on every inbound webhook. This is
# the app secret; keep it identical to META_APP_SECRET unless Meta gives you a
# separate one.
META_WEBHOOK_SECRET=your-app-secret-for-signature-verification
META_API_VERSION=v20.0
# The Embedded Signup configuration. The public /api/v1/whatsapp/config endpoint
# exposes appId/configId to the browser so the signup dialog can open.
META_CONFIG_ID=your-embedded-signup-config-id

# Development only — a single number's credentials, used to point a local build
# at one test number without going through Embedded Signup. Production REFUSES
# to boot if either is set: in a Tech Provider deployment every number belongs
# to a tenant, so their presence means one business is about to send over
# another's number.
# META_PHONE_NUMBER_ID=
# META_ACCESS_TOKEN=

# ── AI / Intent Classification ──
# Set to 'anthropic' (default) or 'nvidia' for local dev testing.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key
HAIKU_FALLBACK_ENABLED=true
HAIKU_CONFIDENCE_THRESHOLD=0.75

# NVIDIA NIM — only needed when AI_PROVIDER=nvidia
# Get a key at: https://build.nvidia.com/explore/discover
NVIDIA_API_KEY=your-nvidia-api-key
# Used by the intent classifier, which only picks one of seven labels on a 3s
# timeout. Speed matters far more than reasoning here.
NVIDIA_MODEL=nvidia/nemotron-nano-3-30b-a3b

# ── The assistant ──
# Reads a message against the shop's catalogue and facts and decides how to
# reply. A much harder task than labelling, so it wants a bigger model than
# NVIDIA_MODEL above. Leave unset to take the provider's default.
#
# WARNING — NVIDIA retires models without notice, and a retired one returns 410
# Gone. The assistant then degrades silently to canned templates: customers are
# still answered, so nothing looks broken. That exact failure ran unnoticed for
# six days in Aug 2026. Verify any value here before trusting it:
#     node qa/nv-pick.mjs <model-id>
# Measured 2026-09-01: of eight candidates only nemotron-3-super was usable
# (4/4 valid JSON, ~6.4s). Kimi K3, Gemma 4 and DeepSeek V4 Flash all exceeded
# 75s on the shared tier — capable models, but not at chat latency.
ASSISTANT_MODEL=nvidia/nemotron-3-super-120b-a12b
# ASSISTANT_TIMEOUT_MS=20000
# ASSISTANT_MAX_TOKENS=2048
# Anthropic only; ignored on NVIDIA.
# ASSISTANT_EFFORT=low

# ── Groq — only needed when AI_PROVIDER=groq ──
# OpenAI-compatible, so it uses the same request shape as NVIDIA above; the
# provider differs only in base URL, key and model id.
#
# Worth having because latency, not intelligence, is what disqualifies models on
# NVIDIA's free shared tier: six of eight candidates failed on time alone, and
# the one survivor still returned 503 "Service temporarily overloaded" under a
# load of three test messages. Groq's hardware targets exactly that problem.
# Its free tier has real rate limits, so treat it as a dev and early-pilot
# option rather than a launch commitment.
#
# Get a key at: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key
# Leave unset to take the provider default. Verify before trusting:
#     node qa/nv-pick.mjs <model-id>
GROQ_MODEL=

# ── Object storage (media uploads: product photos, inbound screenshots) ──
# The variables keep their AWS_ names because that is what deployments already
# set, but the client speaks plain S3 and so speaks to any S3-compatible bucket.
AWS_ACCESS_KEY_ID=your-storage-access-key
AWS_SECRET_ACCESS_KEY=your-storage-secret-key
AWS_REGION=eu-west-1
AWS_S3_BUCKET=your-flowdesk-bucket-name

# Leave S3_ENDPOINT empty for real AWS S3. To use Supabase Storage instead —
# which is where this project already keeps its database — create a private
# bucket, then take an access key pair from Storage -> S3 access keys (NOT the
# anon or service-role JWT) and set:
#   AWS_REGION=<the project's region, e.g. eu-west-2>
#   S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
# Path-style addressing turns on automatically whenever an endpoint is set,
# which is what Supabase, Cloudflare R2 and MinIO all require.
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=

# ── Email (optional, for notifications) ──
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ── Paystack (Billing) ──
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# One Paystack plan per tier. Create them in the Paystack dashboard at
# GHS 150 / 350 / 700 monthly and paste the plan codes here. WITHOUT THESE,
# checkout creates a one-off charge rather than a subscription: nothing
# renews, and cancel/pause/downgrade have no subscription to act on.
PAYSTACK_PLAN_STARTER=PLN_xxxxxxxxxxxx
PAYSTACK_PLAN_BUSINESS=PLN_xxxxxxxxxxxx
PAYSTACK_PLAN_GROWTH=PLN_xxxxxxxxxxxx

# ── Monitoring (optional) ──
SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@xxxxxxxx.ingest.sentry.io/xxxxxxx
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Legal pages (apps/web) - build-time values for /privacy and /terms.
# Any token left empty renders visibly as [[TOKEN]] and keeps the draft banner
# on the page. That is deliberate: an unfilled policy must not look finished.
# All six are required before Meta Business Verification, which checks that we
# publish a real privacy policy. See docs/GO-LIVE-RUNBOOK.md (Blocker 0).
# ---------------------------------------------------------------------------
VITE_LEGAL_COMPANY_NAME=
VITE_LEGAL_ADDRESS=
VITE_LEGAL_COMPANY_NUMBER=
VITE_LEGAL_DPC_NUMBER=
VITE_LEGAL_SUPPORT_EMAIL=
VITE_LEGAL_EFFECTIVE_DATE=
