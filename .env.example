# ── Core ──
NODE_ENV=development
PORT=3000
FRONTEND_URL=https://app.yourdomain.com

# ── Database ──
DIRECT_URL="postgresql://user:password@localhost:5432/flowdesk?schema=public"
# Runtime connection. On Supabase this is the pooled URL (port 6543,
# ?pgbouncer=true); DIRECT_URL above stays on 5432 for migrations.
DATABASE_URL="postgresql://user:password@localhost:5432/flowdesk?schema=public"

# ── Redis ──
REDIS_URL="redis://localhost:6379"

# ── Auth ──
JWT_SECRET="generate-a-64-char-random-string-here-abcdefghijklmnopqrstuvwxyz"
JWT_REFRESH_SECRET="generate-another-64-char-random-string-here-different-from-jwt"

# 32-byte key as 64 hex chars — encrypts secrets at rest (WhatsApp tokens).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-64-hex-char-encryption-key

# ── Meta WhatsApp Cloud API ──
#
# Flowdesk is a Meta Tech Provider. Every business connects its OWN WhatsApp
# Business number through Embedded Signup, and its phone number id, WABA id and
# permanent access token are stored encrypted on that business's row. So these
# are the PLATFORM's app-level credentials only — they are never one number's
# credentials, and one tenant can never send on another's number.
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
# The token Meta echoes back during the webhook subscription handshake.
META_VERIFY_TOKEN=your-webhook-verify-token
# Used to verify the X-Hub-Signature-256 HMAC on every inbound webhook. This is
# the app secret; keep it identical to META_APP_SECRET unless Meta gives you a
# separate one.
META_WEBHOOK_SECRET=your-app-secret-for-signature-verification
META_API_VERSION=v20.0
# The Embedded Signup configuration. The public /api/v1/whatsapp/config endpoint
# exposes appId/configId to the browser so the signup dialog can open.
META_CONFIG_ID=your-embedded-signup-config-id

# Development only — a single number's credentials, used to point a local build
# at one test number without going through Embedded Signup. Production REFUSES
# to boot if either is set: in a Tech Provider deployment every number belongs
# to a tenant, so their presence means one business is about to send over
# another's number.
# META_PHONE_NUMBER_ID=
# META_ACCESS_TOKEN=

# ── AI / Intent Classification ──
# Set to 'anthropic' (default) or 'nvidia' for local dev testing.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key
HAIKU_FALLBACK_ENABLED=true
HAIKU_CONFIDENCE_THRESHOLD=0.75

# NVIDIA NIM — only needed when AI_PROVIDER=nvidia
# Get a key at: https://build.nvidia.com/explore/discover
NVIDIA_API_KEY=your-nvidia-api-key
# Used by the intent classifier, which only picks one of seven labels.
NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# ── The assistant ──
# Reads a message against the shop's catalogue and facts and decides how to
# reply. A much harder task than labelling, so it wants a bigger model than
# NVIDIA_MODEL above. Leave unset to take the provider's default
# (meta/llama-3.3-70b-instruct on NVIDIA, claude-opus-5 on Anthropic).
# ASSISTANT_MODEL=meta/llama-3.3-70b-instruct
# ASSISTANT_TIMEOUT_MS=20000
# ASSISTANT_MAX_TOKENS=2048
# Anthropic only; ignored on NVIDIA.
# ASSISTANT_EFFORT=low

# ── AWS S3 (Media uploads) ──
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=eu-west-1
AWS_S3_BUCKET=your-flowdesk-bucket-name

# ── Email (optional, for notifications) ──
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ── Paystack (Billing) ──
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Monitoring (optional) ──
SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@xxxxxxxx.ingest.sentry.io/xxxxxxx
LOG_LEVEL=info
