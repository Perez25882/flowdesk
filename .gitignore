# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
*.tsbuildinfo

# Vite/Vitest temp config artifacts
*.timestamp-*.mjs

# Turborepo
.turbo/

# Test coverage
coverage/

# Environment
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
typecheck-errors.txt

# Project docs & guides (private)
docs/
.devin/
LAUNCH-GUIDE.md
STARTUP-GUIDE.md
SETUP.md

# Local agent tooling (skills, agents, config) — not part of the product
.claude/

# Local debugging scratch scripts.
# Ad-hoc one-off scripts kept at the api root while chasing a bug. They connect
# to a live database and some hold real tokens, so they must never be committed.
# Anything worth keeping belongs in apps/api/scripts/ with a package.json entry.
apps/api/check-*.ts
apps/api/simulate-webhook.ts
apps/api/test-db.ts
apps/api/update-business-token.ts

# Prisma
apps/api/prisma/*.db

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
Thumbs.db

# Redis snapshot, written if a local redis-server is started from the repo root
dump.rdb

# Dev server logs written when the API/web are started in the background
.api-dev.log
.api-dev.err.log
.web-dev.log
.web-dev.err.log

# Output captured from a local test or typecheck run. Useful while working,
# meaningless once committed — and stale within a day, which is worse than
# absent because someone reads it as current.
test.log
test-output.log
typecheck.log

# Archives taken before a risky change. Kept locally on purpose; committing one
# puts a second copy of the whole tree inside the tree.
*.tar.gz

# Scratch directory used by tooling.
Claude outputs/
