{
  "name": "flowdesk",
  "version": "0.1.0",
  "private": true,
  "description": "Flowdesk — WhatsApp operations layer for Ghanaian SMEs",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "pnpm --filter @flowdesk/api dev",
    "dev:web": "pnpm --filter @flowdesk/web dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rimraf node_modules .turbo",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yaml,yml}\"",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:migrate:dev": "prisma migrate dev --schema prisma/schema.prisma",
    "db:studio": "prisma studio --schema prisma/schema.prisma",
    "smoke": "node apps/api/scripts/smoke-test.mjs",
    "simulate": "pnpm --filter @flowdesk/api exec tsx scripts/simulate-incoming.ts",
    "tunnel": "node apps/api/scripts/tunnel.mjs",
    "whatsapp:setup": "node apps/api/scripts/whatsapp-setup.mjs",
    "verify": "pnpm typecheck && pnpm test && pnpm smoke"
  },
  "devDependencies": {
    "@prisma/client": "^5.22.0",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "prisma": "^5.22.0",
    "rimraf": "^6.0.1",
    "turbo": "^2.1.3",
    "typescript": "^5.6.2"
  }
}
