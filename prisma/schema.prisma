generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// The top-level tenant. Every other record belongs to a Business.
///
/// The Business row doubles as the owner's account: `email` + `passwordHash`
/// are the login credentials. Meta OAuth is used solely to attach a WhatsApp
/// number (`metaUserId` / `waPhoneNumberId`), never as the identity provider.
model Business {
  id                 String             @id @default(cuid())
  name               String
  ownerName          String
  phone              String?
  /// Login identifier for the owner. Stored lowercase.
  email              String?            @unique
  /// bcrypt hash (cost 12). Null until the owner sets a password.
  passwordHash       String?
  emailVerifiedAt    DateTime?
  lastLoginAt        DateTime?
  /// Consecutive failed logins; drives temporary lockout.
  failedLoginCount   Int                @default(0)
  lockedUntil        DateTime?
  /// Meta's id for this business's WhatsApp number. Globally unique: it is the
  /// key inbound webhooks are routed by, so two businesses cannot share one.
  waPhoneNumberId    String?            @unique
  /// AES-256-GCM encrypted access token scoped to THIS business's WABA.
  waAccessToken      String?
  /// WhatsApp Business Account id — needed to manage webhook subscriptions.
  waWabaId           String?
  /// Human-readable number, cached for display without a Graph API call.
  waDisplayNumber    String?
  waVerifiedName     String?
  waWebhookVerified  Boolean            @default(false)
  /// Health of this tenant's WhatsApp connection. Drives whether outbound
  /// sending is attempted and what the owner is told when it is not.
  waConnectionState  WhatsAppConnectionState @default(DISCONNECTED)
  /// Last Meta error for this connection, surfaced in Settings.
  waConnectionError  String?
  waConnectionCheckedAt DateTime?
  /// When the stored token stops working, if Meta reported an expiry.
  waTokenExpiresAt   DateTime?
  plan               BusinessPlan       @default(STARTER)
  trialEndsAt        DateTime?
  suspendedAt        DateTime?
  suspendReason      String?
  paystackCustomerId String?            @unique
  paystackSubCode    String?
  monthlyConvoCount  Int                @default(0)
  convoCountResetAt  DateTime?
  monthlyOrderCount  Int                @default(0)
  orderCountResetAt  DateTime?
  replyTemplates     Json?
  /// What kind of shop this is. Shapes how the assistant reads a message —
  /// "do you have panadol" is a stock question at a pharmacy and noise at a
  /// hardware store.
  businessType       BusinessType?
  /// Free text, only when businessType is OTHER.
  businessTypeOther  String?
  /// Structured, checkable facts — hours, delivery areas and fees, payment
  /// methods, minimums. Validated against `BusinessProfile` in the shared
  /// package. These may ground a reply the assistant sends by itself, because
  /// an answer can be verified against them.
  businessProfile    Json?
  /// Prose the owner wants the assistant to know. Informs DRAFTS only: a
  /// paraphrase of a policy cannot be checked, so it must never justify an
  /// automatic send.
  businessPolicyNotes String?
  /// When the facts were last confirmed. An answer quoted from a delivery fee
  /// nobody has touched in a year deserves less confidence than a fresh one.
  profileUpdatedAt   DateTime?
  /// How much this business lets the assistant do unsupervised.
  aiAssistMode       AiAssistMode       @default(DRAFT_ONLY)
  notifyOnNewOrder   Boolean            @default(true)
  notifyOnLowStock   Boolean            @default(true)
  notifyOnPayment    Boolean            @default(true)
  active             Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  deletedAt          DateTime?
  metaUserId         String?            @unique
  broadcasts         Broadcast[]
  customers          Customer[]
  intentCorrections  IntentCorrection[]
  messages           Message[]
  orders             Order[]
  passwordResets     PasswordResetToken[]
  payments           Payment[]
  pendingOrders      PendingOrder[]
  products           Product[]
  sessions           Session[]
  staff              Staff[]
  stockMovements     StockMovement[]

  @@index([phone])
  @@index([plan])
  @@index([waPhoneNumberId])
  @@index([email])
  @@map("businesses")
}

/// Single-use password reset tokens. Only the SHA-256 hash is stored, so a
/// database leak cannot be replayed against the reset endpoint.
model PasswordResetToken {
  id         String    @id @default(cuid())
  businessId String
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

/// Auth sessions. One per device per user.
/// Refresh tokens stored as SHA-256 hash — never the raw token.
model Session {
  id               String   @id @default(cuid())
  businessId       String
  staffId          String?
  refreshTokenHash String   @unique
  expiresAt        DateTime
  userAgent        String?
  ipAddress        String?
  deviceName       String?
  createdAt        DateTime @default(now())
  lastUsedAt       DateTime @default(now())
  business         Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staff            Staff?   @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([refreshTokenHash])
  @@index([expiresAt])
  @@map("sessions")
}

/// Auto-created on first inbound message. No manual entry required.
model Customer {
  id                 String    @id @default(cuid())
  businessId         String
  waNumber           String
  name               String?
  outstandingBalance Decimal   @default(0) @db.Decimal(12, 2)
  totalSpend         Decimal   @default(0) @db.Decimal(12, 2)
  totalOrders        Int       @default(0)
  blacklisted        Boolean   @default(false)
  waNumberInvalid    Boolean   @default(false)
  vip                Boolean   @default(false)
  tags               String[]  @default([])
  /// Last activity of any kind, inbound or outbound. Drives list ordering and
  /// "last seen" display. NOT a valid basis for the Meta service window — the
  /// owner's own replies bump it (see `lastInboundAt`).
  lastInteractionAt  DateTime?
  /// Last message received FROM this customer.
  ///
  /// Meta's 24-hour customer-service window opens only on a customer-initiated
  /// message, so this is the only field that may gate a free-form send.
  /// `lastInteractionAt` is also written when the owner replies from the
  /// WhatsApp Business app (an `smb_message_echo`), which would push our idea of
  /// the window past the real one: sends would be accepted here, rejected by
  /// Meta, and dead-lettered with nothing shown to the owner.
  lastInboundAt      DateTime?
  firstOrderAt       DateTime?
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?
  business           Business  @relation(fields: [businessId], references: [id])
  messages           Message[]
  orders             Order[]
  pendingOrders      PendingOrder[]
  payments           Payment[]

  @@unique([businessId, waNumber])
  @@index([businessId])
  @@index([businessId, waNumber])
  @@index([businessId, lastInteractionAt(sort: Desc)])
  @@index([businessId, outstandingBalance])
  @@index([businessId, blacklisted])
  @@map("customers")
}

/// Created automatically from ORDER-intent messages or manually by owner.
model Order {
  id              String               @id @default(cuid())
  businessId      String
  customerId      String
  /// FD-XXXXX. The counter is per-business, so uniqueness is scoped to the
  /// tenant — a global unique constraint would collide the moment a second
  /// business issued its own FD-00001.
  referenceNumber String
  rawMessage      String
  isManual        Boolean              @default(false)
  status          OrderStatus          @default(PENDING)
  totalAmount     Decimal              @default(0) @db.Decimal(12, 2)
  amountPaid      Decimal              @default(0) @db.Decimal(12, 2)
  assignedStaffId String?
  stockDeducted   Boolean              @default(false)
  confirmedAt     DateTime?
  fulfilledAt     DateTime?
  cancelledAt     DateTime?
  cancelReason    String?
  notes           String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  deletedAt       DateTime?
  items           OrderItem[]
  statusHistory   OrderStatusHistory[]
  assignedTo      Staff?               @relation(fields: [assignedStaffId], references: [id])
  business        Business             @relation(fields: [businessId], references: [id])
  customer        Customer             @relation(fields: [customerId], references: [id])
  payments        Payment[]

  @@unique([businessId, referenceNumber])
  @@index([businessId])
  @@index([businessId, status])
  @@index([businessId, createdAt(sort: Desc)])
  @@index([businessId, customerId])
  @@index([businessId, assignedStaffId])
  @@index([referenceNumber])
  @@index([businessId, status, createdAt(sort: Desc)])
  @@map("orders")
}

/// Individual line items within an order.
/// Matched items have productId and pricing. Unmatched are description-only.
model OrderItem {
  id              String   @id @default(cuid())
  orderId         String
  productId       String?
  description     String
  quantity        Decimal  @db.Decimal(10, 3)
  unitPrice       Decimal  @default(0) @db.Decimal(12, 2)
  subtotal        Decimal  @default(0) @db.Decimal(12, 2)
  matched         Boolean  @default(false)
  matchConfidence Float?
  createdAt       DateTime @default(now())
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product? @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

/// Immutable record of every order status change.
/// Never updated or deleted. Append-only audit trail.
model OrderStatusHistory {
  id         String       @id @default(cuid())
  orderId    String
  fromStatus OrderStatus?
  toStatus   OrderStatus
  changedBy  String?
  note       String?
  createdAt  DateTime     @default(now())
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_status_history")
}

/// Products owned by the business. Used for order matching, pricing, and inventory.
model Product {
  id               String          @id @default(cuid())
  businessId       String
  name             String
  sku              String?
  aliases          String[]        @default([])
  unit             String
  price            Decimal         @db.Decimal(12, 2)
  stockQuantity    Decimal         @default(0) @db.Decimal(10, 3)
  reorderThreshold Decimal         @default(0) @db.Decimal(10, 3)
  active           Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  deletedAt        DateTime?
  orderItems       OrderItem[]
  business         Business        @relation(fields: [businessId], references: [id])
  stockMovements   StockMovement[]

  @@unique([businessId, sku])
  @@index([businessId])
  @@index([businessId, active])
  @@index([businessId, stockQuantity])
  @@map("products")
}

/// Immutable record of every stock change.
/// Enables full inventory audit trail.
model StockMovement {
  id           String            @id @default(cuid())
  businessId   String
  productId    String
  type         StockMovementType
  quantity     Decimal           @db.Decimal(10, 3)
  balanceAfter Decimal           @db.Decimal(10, 3)
  orderId      String?
  staffId      String?
  note         String?
  createdAt    DateTime          @default(now())
  business     Business          @relation(fields: [businessId], references: [id])
  product      Product           @relation(fields: [productId], references: [id])

  @@index([businessId])
  @@index([productId, createdAt(sort: Desc)])
  @@index([orderId])
  @@map("stock_movements")
}

/// Every payment logged against a customer or order.
model Payment {
  id            String        @id @default(cuid())
  businessId    String
  customerId    String
  orderId       String?
  amount        Decimal       @db.Decimal(12, 2)
  method        PaymentMethod
  reference     String?
  screenshotUrl String?
  screenshotKey String?
  confidence    PaymentConfidence @default(CLAIMED)
  direction     PaymentDirection  @default(IN)
  attestedBy    String?
  attestedAt    DateTime?
  /// Set when a payment is reversed. The row is never deleted: a destroyed
  /// payment is a destroyed alibi, and disputes turn on exactly this record.
  voidedAt      DateTime?
  voidedBy      String?
  voidReason    String?
  loggedById    String?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  business      Business      @relation(fields: [businessId], references: [id])
  customer      Customer      @relation(fields: [customerId], references: [id])
  order         Order?        @relation(fields: [orderId], references: [id])

  @@index([businessId])
  @@index([businessId, customerId])
  @@index([businessId, orderId])
  @@index([businessId, confidence])
  @@index([businessId, voidedAt])
  @@index([businessId, createdAt(sort: Desc)])
  @@map("payments")
}

/// Every WhatsApp message — inbound and outbound.
/// The primary record for everything that passes through the system.
model Message {
  id               String                @id @default(cuid())
  businessId       String
  customerId       String?
  waMessageId      String                @unique
  direction        MessageDirection
  type             MessageType           @default(TEXT)
  body             String?
  mediaUrl         String?
  mediaKey         String?
  mediaType        String?
  reactionEmoji    String?
  reactedToWaId    String?
  intent           IntentType            @default(UNCLASSIFIED)
  intentConfidence Float?
  classifiedBy     ClassificationSource?
  processed        Boolean               @default(false)
  processedAt      DateTime?
  processingError  String?
  requiresReview   Boolean               @default(false)
  relatedOrderId   String?
  rawPayload       Json?
  /// True when the owner sent this from the WhatsApp Business app on their own
  /// phone (coexistence echo) rather than through Flowdesk. Auto-replies are
  /// suppressed for a window after one of these, so the assistant never talks
  /// over a human who has just taken the conversation over.
  sentFromApp      Boolean               @default(false)

  // ── Assistant reply ─────────────────────────────────────────────────────
  // A reply the assistant wrote for THIS inbound message. Kept on the message
  // rather than in its own table because it is strictly one-per-message and the
  // review UI already reads messages.

  /// The suggested reply text. Survives sending, so an owner can see what went
  /// out and how much they had to change it.
  aiReplyText        String?
  aiReplyStatus      AiReplyStatus?
  /// Evidence ids the answer was built from (`product:<id>`, `fact:deliveryFee`).
  /// Recorded so a wrong answer can be traced to what it was derived from.
  aiReplyGroundedOn  String[]              @default([])
  /// Guardrail checks the generated text failed. Non-empty forces a draft.
  aiValidationFailed String[]              @default([])
  /// The full decision envelope, for auditing and offline evaluation. Never
  /// read at runtime — routing decisions are made from the typed columns.
  aiDecision         Json?
  aiReplyModel       String?
  aiDetectedLanguage String?

  /// The inbound message an outbound row is answering. `relatedOrderId` is a
  /// bare string with no relation, so without this there is no way to render a
  /// thread — or to measure how often owners edit what the assistant wrote,
  /// which is the one number that says whether it can be trusted to send.
  inReplyToMessageId String?
  /// Set when a person sent this from the dashboard rather than automation.
  sentByStaffId      String?

  createdAt        DateTime              @default(now())
  business         Business              @relation(fields: [businessId], references: [id])
  customer         Customer?             @relation(fields: [customerId], references: [id])

  @@index([businessId])
  @@index([waMessageId])
  @@index([businessId, processed])
  @@index([businessId, requiresReview])
  @@index([businessId, intent])
  @@index([businessId, createdAt(sort: Desc)])
  @@index([businessId, processed, createdAt(sort: Desc)])
  /// Serves the human-takeover lookup: newest app-sent message per customer.
  @@index([customerId, sentFromApp, createdAt(sort: Desc)])
  /// Serves conversation reconstruction: the recent back-and-forth with one
  /// customer, newest first, which the assistant needs as context.
  @@index([businessId, customerId, createdAt(sort: Desc)])
  /// Serves the owner's queue of drafts waiting to be sent.
  @@index([businessId, aiReplyStatus, createdAt(sort: Desc)])
  @@index([inReplyToMessageId])
  @@map("messages")
}

/// Tracks when owners manually correct the system's intent classification.
/// Used to detect patterns and improve the rule engine over time.
model IntentCorrection {
  id                 String                @id @default(cuid())
  businessId         String
  messageId          String
  originalIntent     IntentType
  correctedIntent    IntentType
  originalSource     ClassificationSource?
  originalConfidence Float?
  correctedBy        String
  createdAt          DateTime              @default(now())
  business           Business              @relation(fields: [businessId], references: [id])

  @@index([businessId])
  @@index([originalIntent, correctedIntent])
  @@index([createdAt])
  @@map("intent_corrections")
}

/// Staff members with scoped access to the business dashboard.
model Staff {
  id               String          @id @default(cuid())
  businessId       String
  name             String
  phone            String
  role             StaffRole
  active           Boolean         @default(true)
  passwordHash     String?
  inviteToken      String?         @unique
  inviteExpiry     DateTime?
  invitedAt        DateTime        @default(now())
  inviteAcceptedAt DateTime?
  lastLoginAt      DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  assignedOrders   Order[]
  sessions         Session[]
  business         Business        @relation(fields: [businessId], references: [id])
  activityLog      StaffActivity[]

  @@unique([businessId, phone])
  @@index([businessId])
  @@index([businessId, active])
  @@index([inviteToken])
  @@map("staff")
}

/// Immutable log of staff actions for owner audit trail.
model StaffActivity {
  id           String   @id @default(cuid())
  staffId      String
  action       String
  resourceId   String?
  resourceType String?
  note         String?
  createdAt    DateTime @default(now())
  staff        Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
  @@index([staffId, createdAt(sort: Desc)])
  @@index([resourceType, resourceId])
  @@map("staff_activity")
}

/// WhatsApp broadcast messages sent to customer segments. Business plan+.
model Broadcast {
  id             String    @id @default(cuid())
  businessId     String
  templateName   String
  message        String
  variables      Json?
  targetTags     String[]  @default([])
  targetAll      Boolean   @default(false)
  recipientCount Int       @default(0)
  sentCount      Int       @default(0)
  failedCount    Int       @default(0)
  status         String    @default("draft")
  scheduledAt    DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  createdBy      String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  business       Business  @relation(fields: [businessId], references: [id])

  @@index([businessId])
  @@index([businessId, status])
  @@index([scheduledAt])
  @@map("broadcasts")
}

enum BusinessPlan {
  STARTER
  BUSINESS
  GROWTH
  ENTERPRISE
  SUSPENDED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  FULFILLED
  CANCELLED
}

enum PaymentMethod {
  MOMO_MTN
  MOMO_VODAFONE
  MOMO_AIRTELTIGO
  CASH
  BANK_TRANSFER
  OTHER
}

/// Whose word a payment rests on. See packages/shared/src/payment-integrity.ts —
/// the member names and their order must stay in step with PAYMENT_CONFIDENCES.
enum PaymentConfidence {
  CLAIMED
  SELLER_ATTESTED
  TELCO_MATCHED
  GATEWAY_CONFIRMED
}

/// IN is money received. OUT is a refund back to the customer.
enum PaymentDirection {
  IN
  OUT
}

enum StaffRole {
  MANAGER
  OPERATIONS
  DELIVERY
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
  STICKER
  REACTION
  BUTTON_REPLY
  LIST_REPLY
  UNKNOWN
}

enum IntentType {
  ORDER
  PAYMENT
  INQUIRY
  STATUS_CHECK
  COMPLAINT
  GREETING
  OTHER
  UNCLASSIFIED
}

/// Lifecycle of an assistant-written reply.
enum AiReplyStatus {
  /// Written, waiting for the owner. Editable.
  DRAFT
  /// Sent by the assistant on its own, because the answer was grounded and
  /// passed every guardrail.
  AUTO_SENT
  /// Sent by a person from the dashboard, edited or not.
  SENT
  /// The owner decided not to reply.
  DISMISSED
  /// The customer said something else before the draft was sent, so it answers
  /// a question that has moved on and must not be sent as written.
  SUPERSEDED
  /// The 24-hour service window closed before anyone sent it.
  EXPIRED
}

/// Kind of business. Mirrors `BUSINESS_TYPES` in `@flowdesk/shared`.
enum BusinessType {
  PROVISIONS
  FOOD
  FASHION
  BEAUTY
  ELECTRONICS
  PHARMACY
  HARDWARE
  AGRICULTURE
  WHOLESALE
  SERVICES
  OTHER
}

/// How much the assistant may do without the owner. Mirrors `AI_ASSIST_MODES`.
enum AiAssistMode {
  /// Fixed templates only — the assistant writes nothing.
  OFF
  /// The assistant writes replies; the owner sends them.
  DRAFT_ONLY
  /// The assistant answers directly when the answer is grounded and verified,
  /// and drafts everything else.
  GROUNDED_AUTO
}

enum ClassificationSource {
  RULE_ENGINE
  HAIKU
  MANUAL
}

/// Health of a business's WhatsApp connection.
///
/// Anything other than ACTIVE suspends outbound sending for that tenant only —
/// inbound messages are always accepted and stored regardless of state.
enum WhatsAppConnectionState {
  /// No number connected yet.
  DISCONNECTED
  /// Connected and sending normally.
  ACTIVE
  /// Meta rejected the token (expired or revoked). Owner must reconnect.
  TOKEN_INVALID
  /// Number is unusable — deleted at Meta, or banned for quality.
  NUMBER_UNAVAILABLE
  /// Temporarily throttled by Meta. Recovers without owner action.
  RATE_LIMITED
}

enum StockMovementType {
  SALE
  RESTOCK
  ADJUSTMENT
  RETURN
}

/// An order that has been asked about but is not yet clear enough to create.
///
/// The alternative was creating an `Order` immediately and patching it as the
/// conversation went on, which puts half-formed rows in front of the owner and
/// counts them against their plan before anyone has agreed to buy anything.
/// Holding the draft here instead means an `Order` only ever exists once the
/// customer has actually said what they want.
model PendingOrder {
  id                String             @id @default(cuid())
  businessId        String
  customerId        String
  /// Items understood so far — the same shape as the assistant's product
  /// mentions, not order items, because prices are not settled yet.
  draftItems        Json               @default("[]")
  /// What still has to be answered before this can become an order.
  missing           String[]           @default([])
  /// How many questions we have already asked. Capped, then handed to a person:
  /// a customer who has not answered twice will not be helped by a third ask.
  clarificationCount Int               @default(0)
  /// The question currently outstanding, so a bare "2 bags" is read as its answer.
  lastQuestion      String?
  status            PendingOrderStatus @default(AWAITING_REPLY)
  /// The inbound message that started it, for tracing back from the order.
  sourceMessageId   String?
  /// Set once this becomes a real order. Also the idempotency guard: a second
  /// attempt to convert the same pending order finds this already populated.
  resolvedOrderId   String?
  /// Evaluated on read rather than swept. This repo has no scheduler, and adding
  /// one to expire a handful of rows would be a lot of moving parts for a
  /// timestamp comparison that any read can do.
  expiresAt         DateTime
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  business          Business           @relation(fields: [businessId], references: [id])
  customer          Customer           @relation(fields: [customerId], references: [id])

  /// Drives the "awaiting reply" surface on the dashboard.
  @@index([businessId, status, updatedAt])
  @@map("pending_orders")
}

enum PendingOrderStatus {
  /// We have asked a question and are waiting on the customer.
  AWAITING_REPLY
  /// Became a real order.
  RESOLVED
  /// Went quiet for long enough that a reply would be confusing.
  EXPIRED
  /// The customer changed the subject, or a person took the conversation over.
  ABANDONED
}
